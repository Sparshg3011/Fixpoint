# Copy this file to .env and fill in a key. .env is gitignored and never
# committed. Run scripts load it automatically.
#
#   cp .env.example .env
#
# --- DEFAULT: free open-weight models via NVIDIA NIM -------------------------
# No credit card. Get a key at https://build.nvidia.com (click any model ->
# "Get API Key"). This is the configuration the published results use.
NVIDIA_API_KEY=nvapi-...
FIXPOINT_BACKEND=openai
FIXPOINT_BASE_URL=https://integrate.api.nvidia.com/v1
FIXPOINT_MODEL=z-ai/glm-5.2
#
# Other free models on the same endpoint (all measured to work):
#   nvidia/nemotron-3-ultra-550b-a55b     550B reasoning, 1M context
#   nvidia/nemotron-3-super-120b-a12b
#   moonshotai/kimi-k2.6
#   deepseek-ai/deepseek-v4-flash-0731

# --- Local, fully offline (Ollama) — no key required ------------------------
# FIXPOINT_BACKEND=openai
# FIXPOINT_BASE_URL=http://localhost:11434/v1
# FIXPOINT_MODEL=qwen2.5-coder:7b

# --- Paid comparison runs (optional) ----------------------------------------
# Z.ai direct (GLM): ~$0.60/M in, $2.20/M out
# ZAI_API_KEY=...
# FIXPOINT_BASE_URL=https://api.z.ai/api/paas/v4
#
# Anthropic — only needed to reproduce the paid comparison row in the README
# ANTHROPIC_API_KEY=sk-ant-...
# FIXPOINT_BACKEND=anthropic
# FIXPOINT_MODEL=claude-sonnet-5
