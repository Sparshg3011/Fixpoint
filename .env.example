# Copy this file to .env and fill in the keys you use. .env is gitignored and
# never committed. Run scripts load it automatically.
#
#   cp .env.example .env
#
# --- Anthropic (the default backend; the published result was produced here) --
ANTHROPIC_API_KEY=sk-ant-...

# --- Any OpenAI-compatible endpoint (NVIDIA NIM, Z.ai/GLM, OpenRouter, Ollama)
# Uncomment and fill to switch backends. FIXPOINT_BACKEND=anthropic is default.
#
# NVIDIA NIM — free, no credit card, key from https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-...
# FIXPOINT_BACKEND=openai
# FIXPOINT_BASE_URL=https://integrate.api.nvidia.com/v1
# FIXPOINT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
#
# Z.ai (GLM) — ~$0.60/M in, $2.20/M out
# ZAI_API_KEY=...
# FIXPOINT_BACKEND=openai
# FIXPOINT_BASE_URL=https://api.z.ai/api/paas/v4
# FIXPOINT_MODEL=glm-4.6
#
# Local Ollama — free, no key needed
# FIXPOINT_BACKEND=openai
# FIXPOINT_BASE_URL=http://localhost:11434/v1
# FIXPOINT_MODEL=qwen2.5-coder:7b
